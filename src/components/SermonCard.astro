---
import { withBase } from '../lib/paths';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  sermon: CollectionEntry<'sermons'>;
  index?: number;
}

const { sermon, index = 1 } = Astro.props;
const dateLabel = new Intl.DateTimeFormat('en-MY', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(sermon.data.date);
---

<a class="sermon-card" href={withBase(`/sermons/${sermon.id}/`)}>
  <div>
    <div class="sermon-card__meta">
      <span>{dateLabel}</span>
      <span>{sermon.data.speaker}</span>
    </div>
    <h3 class="sermon-card__title">{sermon.data.title}</h3>
  </div>
  <div class="sermon-card__footer">
    <span class="sermon-card__read">
      Read &amp; reflect
      <Icon name="arrow-right" size={16} />
    </span>
    <span class="sermon-card__index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
  </div>
</a>
