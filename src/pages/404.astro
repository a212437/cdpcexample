---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arches from '../components/Arches.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Page not found"
  description="That page could not be found. Return to CDPC Puchong or plan your first visit."
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <Arches class="not-found__arches" />
    <div class="container-page not-found__inner">
      <div class="not-found__copy">
        <p class="eyebrow">404 · Page not found</p>
        <h1 class="not-found__title" id="not-found-title">
          This page has <em>wandered off.</em>
        </h1>
        <p class="lead mt-6">
          The page you were looking for may have moved, or the link may be incomplete. You
          are still very welcome here.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn--primary" href={withBase('/')}>
            Back home
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn--ghost" href={withBase('/visit')}>
            Plan your visit
          </a>
        </div>
        <div class="mt-10 border-t border-[var(--line)] pt-6">
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-[var(--ink-faint)]">
            Looking for something?
          </p>
          <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
            <li><a class="text-link" href={withBase('/sermons')}>Sermons</a></li>
            <li><a class="text-link" href={withBase('/events')}>Events</a></li>
            <li><a class="text-link" href={withBase('/where-we-gather')}>Directions</a></li>
            <li><a class="text-link" href={withBase('/childrens-library')}>Library</a></li>
            <li><a class="text-link" href={withBase('/contact')}>Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="not-found__number" aria-hidden="true">404</div>
    </div>
  </section>
</BaseLayout>
