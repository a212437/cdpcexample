---
import { withBase } from '../lib/paths';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import InfoCard from '../components/InfoCard.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';
import worship from '../content/worship.json';
import whoImage from '../assets/images/who-we-are-placeholder.jpg';

const description =
  'Meet CDPC Puchong: a church of diverse followers of Jesus in Bandar Puchong Jaya, gathered for Christ-centred worship, Scripture-based expository preaching and grace-enabled spirituality.';
---

<BaseLayout title="Who We Are" description={description}>
  <PageHero
    eyebrow="About CDPC Puchong"
    title="A diverse family, <em>gathered by grace.</em>"
    intro={site.whoWeAre}
    breadcrumbs={[{ label: 'About' }]}
  />

  <section class="section" aria-labelledby="life-title">
    <div class="container-page">
      <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
        <figure class="figure lg:col-span-6" data-reveal>
          <div class="figure__media aspect-landscape">
            <Picture
              src={whoImage}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 1024px) 48vw, 100vw"
              alt="Abstract artwork of an arched window opening onto warm afternoon light"
              loading="eager"
              quality={82}
              decoding="async"
            />
          </div>
          <span class="figure__frame" aria-hidden="true"></span>
          <figcaption class="figure__caption">
            <span>Light through the arches</span>
            <span>Placeholder artwork</span>
          </figcaption>
        </figure>

        <div class="lg:col-span-5 lg:col-start-8" data-reveal style="--delay: 100ms">
          <p class="eyebrow">Our life together</p>
          <h2 class="h2 mt-5" id="life-title">Rooted in Christ. Renewed by grace.</h2>
          <p class="lead mt-6">{site.tagline}</p>
          <p class="mt-5 text-[0.95rem] leading-relaxed text-[var(--ink-soft)]">
            We are made up of people from different backgrounds and seasons of life. What
            holds us together is not having it all figured out, but the grace of God in Jesus.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a class="btn btn--primary" href={withBase('/visit')}>
              Visit this Sunday
              <Icon name="arrow-right" size={16} />
            </a>
            <a class="text-link" href={withBase('/beliefs')}>
              What we believe
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--paper-2)]" aria-labelledby="values-title">
    <div class="container-page">
      <div class="section-head" data-reveal>
        <p class="eyebrow">What shapes us</p>
        <h2 class="h2" id="values-title">Christ, Scripture, grace.</h2>
        <p class="lead">
          These are not slogans for us. They describe the centre of our worship and the way
          we hope to live together.
        </p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          worship.pillars.map((pillar, index) => (
            <article class="card p-7 md:p-8" data-reveal style={`--delay: ${index * 80}ms`}>
              <span class="font-display text-[0.85rem] italic text-[var(--accent)]">
                {pillar.number}
              </span>
              <h3 class="mt-4 font-display text-[1.55rem] leading-[1.1] tracking-[-0.03em]">
                {pillar.title}
              </h3>
              <p class="mt-3 text-[0.92rem] leading-relaxed text-[var(--ink-soft)]">
                {pillar.text}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="explore-title">
    <div class="container-page">
      <div class="section-top">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Take a closer look</p>
          <h2 class="h2" id="explore-title">Get to know us a little more.</h2>
        </div>
        <a class="text-link" href={withBase('/leadership')} data-reveal>
          Leadership
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div data-reveal>
          <InfoCard
            icon="users"
            title="Leadership"
            text="Meet Pastor Josh Ng, our elders and our deacons."
            href={withBase('/leadership')}
            linkLabel="Meet the team"
          />
        </div>
        <div data-reveal style="--delay: 60ms">
          <InfoCard
            icon="book-open"
            title="What we believe"
            text="The Bible's story of creation, fall, redemption, renewal and consummation."
            href={withBase('/beliefs')}
            linkLabel="Read our beliefs"
          />
        </div>
        <div data-reveal style="--delay: 120ms">
          <InfoCard
            icon="library"
            title="Children's Library"
            text="English books and Story Time for toddlers through to adults."
            href={withBase('/childrens-library')}
            linkLabel="Visit the library"
          />
        </div>
        <div data-reveal style="--delay: 180ms">
          <InfoCard
            icon="map-pin"
            title="Plan a visit"
            text="Sundays at 9:00AM on the 7th floor of IOI Boulevard, Puchong."
            href={withBase('/visit')}
            linkLabel="Plan your visit"
          />
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
