---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import beliefs from '../content/beliefs.json';

const description =
  "What CDPC Puchong believes: the Bible's story of creation, fall, redemption, renewal and consummation, summarised in the Apostles' Creed, Nicene Creed and Westminster Standards.";
---

<BaseLayout title="What We Believe" description={description}>
  <PageHero
    eyebrow="What we believe"
    title="The story we live in."
    intro={beliefs.intro}
    breadcrumbs={[{ label: 'About', href: '/about' }, { label: 'What we believe' }]}
  />

  <section class="section" aria-labelledby="story-title">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32" data-reveal>
            <p class="eyebrow">The Biblical story</p>
            <h2 class="h2 mt-5" id="story-title">Five movements of grace.</h2>
            <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed text-[var(--ink-soft)]">
              The Bible is not a collection of disconnected rules. It tells one story — and
              every part of it leads us to Jesus.
            </p>
            <nav class="mt-8 hidden border-l border-[var(--line)] pl-5 lg:block" aria-label="Beliefs on this page">
              <ul class="space-y-2.5">
                {
                  beliefs.points.map((point) => (
                    <li>
                      <a
                        class="group flex items-baseline gap-3 text-[0.82rem] text-[var(--ink-soft)] transition-colors hover:text-[var(--ink)]"
                        href={`#${point.id}`}
                      >
                        <span class="font-display text-[0.72rem] italic text-[var(--ink-faint)]">
                          {point.number}
                        </span>
                        <span class="border-b border-transparent pb-0.5 transition-colors group-hover:border-[var(--accent)]">
                          {point.title}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </div>

        <div class="lg:col-span-8">
          <div class="belief-list">
            {
              beliefs.points.map((point, index) => (
                <article
                  class="belief"
                  id={point.id}
                  data-reveal
                  style={`--delay: ${index * 60}ms`}
                >
                  <div class="belief__number" aria-hidden="true">
                    {point.number}
                  </div>
                  <div class="belief__body">
                    <h3 class="belief__title">{point.title}</h3>
                    <p class="belief__text">{point.text}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bible-band" aria-labelledby="bible-title">
    <div class="container-page">
      <div class="bible-band__inner">
        <div class="bible-band__mark" aria-hidden="true">
          <Icon name="book-open" size={30} strokeWidth={1.2} />
        </div>
        <div data-reveal>
          <p class="eyebrow eyebrow--light">Our authority</p>
          <h2 class="bible-band__title mt-5" id="bible-title">{beliefs.scripture.heading}</h2>
          <p class="bible-band__text mt-6">{beliefs.scripture.text}</p>
        </div>
        <div class="bible-band__aside" data-reveal style="--delay: 100ms">
          <p class="font-display text-[clamp(2.6rem,5vw,4.5rem)] leading-none text-[var(--paper)]">66</p>
          <p class="mt-2 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-[var(--paper-40)]">
            books, one story
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="creeds-title">
    <div class="container-page">
      <div class="section-head" data-reveal>
        <p class="eyebrow">With the church across time</p>
        <h2 class="h2" id="creeds-title">{beliefs.creeds.heading}.</h2>
        <p class="lead">{beliefs.creeds.text}</p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7" data-reveal>
          <div class="creed-card">
            <div class="flex items-center justify-between gap-4">
              <h3 class="font-display text-[1.65rem] leading-tight tracking-[-0.03em]">
                The Apostles' Creed
              </h3>
              <Icon name="quote" size={24} class="text-[var(--accent)]" />
            </div>
            <div class="creed-text mt-7">
              {beliefs.creeds.apostlesCreed.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <p class="creed-note mt-7">
              {beliefs.creeds.catholicNote}
            </p>
          </div>
        </div>

        <div class="lg:col-span-5" data-reveal style="--delay: 100ms">
          <div class="flex h-full flex-col justify-between gap-8">
            <div>
              <p class="eyebrow">Read further</p>
              <p class="mt-4 max-w-md text-[0.95rem] leading-relaxed text-[var(--ink-soft)]">
                These historic summaries are not additions to Scripture. They help us say
                clearly what the Bible says, together with believers across generations.
              </p>
            </div>

            <div class="space-y-3">
              <a
                class="creed-link"
                href={beliefs.creeds.nicene.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="flex items-center gap-3">
                  <span class="creed-link__icon"><Icon name="book" size={17} /></span>
                  {beliefs.creeds.nicene.label}
                </span>
                <Icon name="arrow-up-right" size={17} />
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
              <a
                class="creed-link"
                href={beliefs.creeds.westminster.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="flex items-center gap-3">
                  <span class="creed-link__icon"><Icon name="book" size={17} /></span>
                  {beliefs.creeds.westminster.label}
                </span>
                <Icon name="arrow-up-right" size={17} />
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
              <p class="pt-2 text-[0.75rem] leading-relaxed text-[var(--ink-faint)]">
                Both links open an external website in a new tab.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="Come and worship"
    title="These truths are better sung, prayed and lived together."
    text="Join us on Sunday at 9:00AM, or message us if you have a question before you come."
  />
</BaseLayout>
