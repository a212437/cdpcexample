---
import { withBase } from '../lib/paths';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import InfoCard from '../components/InfoCard.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import site from '../content/site.json';
import library from '../content/library.json';
import libraryImage from '../assets/images/library-placeholder.jpg';

const description =
  "The Children's Library at CDPC Puchong: a great collection of English books and a Story Time session, catered for people from toddlers to adults.";

const ages = ['Toddlers', 'Children', 'Teens', 'Adults'];
---

<BaseLayout title="Children's Library" description={description}>
  <PageHero
    eyebrow="Children's Library"
    title="Stories for every age."
    intro={library.intro}
    breadcrumbs={[
      { label: 'About', href: '/about' },
      { label: "Children's Library" },
    ]}
  />

  <section class="section" aria-labelledby="collection-title">
    <div class="container-page">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
        <figure class="figure lg:col-span-7" data-reveal>
          <div class="figure__media aspect-portrait">
            <Picture
              src={libraryImage}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 56vw, 100vw"
              alt="Abstract artwork of warm shelves and books in afternoon light"
              loading="eager"
              quality={82}
              decoding="async"
            />
          </div>
          <span class="figure__frame" aria-hidden="true"></span>
          <figcaption class="figure__caption">
            <span>Room to read, wonder and grow</span>
            <span>Placeholder artwork</span>
          </figcaption>
        </figure>

        <div class="lg:col-span-4 lg:col-start-9" data-reveal style="--delay: 100ms">
          <p class="eyebrow">The collection</p>
          <h2 class="h2 mt-5" id="collection-title">{library.collection.heading}.</h2>
          <p class="lead mt-6">{library.collection.text}</p>
          <ul class="mt-7 flex flex-wrap gap-2" aria-label="Ages the library caters for">
            {
              ages.map((age) => (
                <li class="rounded-full border border-[var(--line-strong)] px-3.5 py-1.5 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-[var(--ink-soft)]">
                  {age}
                </li>
              ))
            }
          </ul>
          <p class="mt-7 text-[0.85rem] leading-relaxed text-[var(--ink-faint)]">
            The collection is in English. Borrowing and opening-hours details are still
            being confirmed with the church.
          </p>
          <a
            class="text-link mt-5"
            href={site.contact.whatsapp}
            target="_blank"
            rel="noopener"
          >
            <Icon name="message-circle" size={16} />
            Ask about the library
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm bg-[var(--paper-2)]" aria-labelledby="story-time-title">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5" data-reveal>
          <p class="eyebrow">Story Time</p>
          <h2 class="h2 mt-5" id="story-time-title">A story, shared together.</h2>
          <p class="lead mt-6">
            Story Time is part of the library's life — a simple way for children and adults
            to gather around a good book.
          </p>
          <span class="status-chip mt-6">Day and time being confirmed</span>
        </div>
        <div class="lg:col-span-6 lg:col-start-7" data-reveal style="--delay: 100ms">
          <div class="rounded-[24px] border border-[var(--line)] bg-[var(--card)] p-7 md:p-9">
            <span class="icon-badge">
              <Icon name="book-open" size={22} />
            </span>
            <h3 class="mt-5 font-display text-[1.9rem] leading-[1.08] tracking-[-0.03em]">
              {library.storyTime.heading}
            </h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-[var(--ink-soft)]">
              {library.storyTime.text}
            </p>
            <p class="mt-5 border-t border-[var(--line)] pt-5 text-[0.82rem] leading-relaxed text-[var(--ink-faint)]">
              <!-- TODO: confirm with church — Story Time day, time, age grouping and format; borrowing process, opening hours and library location within the venue. -->
              Want to bring a child or a group? Message us and we will confirm the details
              before you come.
            </p>
            <a
              class="btn btn--ghost mt-5"
              href={site.contact.whatsapp}
              target="_blank"
              rel="noopener"
            >
              <Icon name="message-circle" size={16} />
              Ask about Story Time
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </div>

      <div class="mt-8 grid gap-3 md:grid-cols-3">
        <div data-reveal>
          <InfoCard
            icon="library"
            title={library.collection.heading}
            text={library.collection.text}
          />
        </div>
        <div data-reveal style="--delay: 60ms">
          <InfoCard
            icon="book"
            title={library.borrowing.heading}
            status={library.borrowing.status as 'confirmed' | 'to-confirm' | 'partly-confirmed'}
            text={library.borrowing.text}
          />
        </div>
        <div data-reveal style="--delay: 120ms">
          <InfoCard
            icon="map-pin"
            title={library.location.heading}
            status={library.location.status as 'confirmed' | 'to-confirm' | 'partly-confirmed'}
            text={library.location.text}
            href={withBase('/where-we-gather')}
            linkLabel="How to find us"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="library-visit-title">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7" data-reveal>
          <p class="eyebrow">While you are with us</p>
          <h2 class="h2 mt-5" id="library-visit-title">A place for curiosity.</h2>
          <p class="lead mt-6">
            Books can open conversations that last longer than a Sunday. Whether you are
            looking for something for a toddler, a teenager or yourself, we hope the library
            is a quiet gift to the church and the neighbourhood.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn--primary" href={withBase('/visit')}>
              Plan your visit
              <Icon name="arrow-right" size={16} />
            </a>
            <a class="btn btn--ghost" href={withBase('/about')}>
              More about CDPC
            </a>
          </div>
        </div>
        <div class="lg:col-span-4 lg:col-start-9" data-reveal style="--delay: 100ms">
          <div class="border-t border-[var(--line-strong)] pt-6">
            <p class="font-display text-[clamp(1.6rem,2.8vw,2.2rem)] leading-[1.2] tracking-[-0.03em]">
              “A great collection of English books with a Story Time session.”
            </p>
            <p class="mt-4 text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[var(--ink-faint)]">
              A place for toddlers to adults
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="Read with us"
    title="Every good story points beyond itself."
    text="Come and explore the library, or message us with a question about Story Time and borrowing."
  />
</BaseLayout>
