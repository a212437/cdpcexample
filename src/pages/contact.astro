---
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import InfoCard from '../components/InfoCard.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';

const description =
  'Get in touch with CDPC Puchong on WhatsApp. Ask about Sundays, the Children’s Library, sermons or anything else — the church meets at IOI Boulevard, Puchong.';
---

<BaseLayout title="Contact" description={description}>
  <PageHero
    eyebrow="Contact"
    title="We would love to hear from you."
    intro="Whether you have a question before your first visit, would like to know more about the church, or simply want to say hello, the quickest way to reach us is on WhatsApp."
    breadcrumbs={[{ label: 'Contact' }]}
  >
    <div slot="aside" class="contact-note">
      <span class="icon-badge">
        <Icon name="message-circle" size={21} />
      </span>
      <p class="eyebrow mt-5">{site.contact.whatsappLabel}</p>
      <p class="mt-4 font-display text-[clamp(1.5rem,2.4vw,1.9rem)] leading-[1.2] tracking-[-0.025em]">
        Messages go directly to the church.
      </p>
      <a
        class="btn btn--primary mt-6 w-full"
        href={site.contact.whatsapp}
        target="_blank"
        rel="noopener"
      >
        <Icon name="message-circle" size={17} />
        Open WhatsApp
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
      <p class="mt-4 text-[0.72rem] leading-relaxed text-[var(--ink-faint)]">
        This link opens WhatsApp in a new tab.
      </p>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="contact-details-title">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6" data-reveal>
          <p class="eyebrow">The simplest way</p>
          <h2 class="h2 mt-5" id="contact-details-title">Send us a message.</h2>
          <p class="lead mt-6">
            We do not ask you to fill in a form or create an account. Message us on WhatsApp
            and someone from the church will be glad to help.
          </p>
          <a
            class="btn btn--primary mt-8"
            href={site.contact.whatsapp}
            target="_blank"
            rel="noopener"
          >
            <Icon name="message-circle" size={17} />
            {site.contact.whatsappLabel}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>

        <div class="lg:col-span-5 lg:col-start-8" data-reveal style="--delay: 100ms">
          <div class="contact-details">
            <div class="contact-details__row">
              <span class="icon-badge"><Icon name="map-pin" size={19} /></span>
              <div>
                <p class="contact-details__label">Where we meet</p>
                <!-- TODO: confirm with church — verify the exact unit. Old site footer listed "B-7-1"; supplied address lists "Unit B, 01, 7th Floor". -->
                <address class="contact-details__text">
                  7th Floor, IOI Boulevard, Unit B, 01<br />
                  Jalan Kenari 5, Bandar Puchong Jaya<br />
                  47170 Puchong, Selangor
                </address>
                <a class="text-link mt-2" href={withBase('/where-we-gather')}>
                  Directions
                  <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </div>
            <div class="contact-details__row">
              <span class="icon-badge"><Icon name="clock" size={19} /></span>
              <div>
                <p class="contact-details__label">When we meet</p>
                <p class="contact-details__text">
                  Worship Service<br />
                  Every Sunday at 9:00AM
                </p>
                <a class="text-link mt-2" href={withBase('/visit')}>
                  Plan your visit
                  <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm bg-[var(--paper-2)]" aria-labelledby="ask-title">
    <div class="container-page">
      <div class="section-head" data-reveal>
        <p class="eyebrow">However we can help</p>
        <h2 class="h2" id="ask-title">What would you like to ask?</h2>
        <p class="lead">
          There is no wrong question. These are a few of the things people often get in
          touch about.
        </p>
      </div>

      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div data-reveal>
          <InfoCard
            icon="compass"
            title="A first visit"
            text="Service time, the address, what to expect and how to find the room."
            href={withBase('/visit')}
            linkLabel="Plan a visit"
          />
        </div>
        <div data-reveal style="--delay: 60ms">
          <InfoCard
            icon="library"
            title="Children & the library"
            text="Ask about the Children’s Library, Story Time and bringing children."
            href={withBase('/childrens-library')}
            linkLabel="The library"
          />
        </div>
        <div data-reveal style="--delay: 120ms">
          <InfoCard
            icon="play"
            title="Sermons & teaching"
            text="Ask about recent sermons, recordings or what we believe."
            href={withBase('/sermons')}
            linkLabel="Browse sermons"
          />
        </div>
        <div data-reveal style="--delay: 180ms">
          <InfoCard
            icon="users"
            title="Church life"
            text="Meet our leadership or learn more about the life of the church."
            href={withBase('/leadership')}
            linkLabel="Our leadership"
          />
        </div>
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="Sundays at 9:00AM"
    title="Or simply come and say hello."
    text="You are welcome to join us at IOI Boulevard, Puchong. Plan your visit or message us before you come."
  />
</BaseLayout>
