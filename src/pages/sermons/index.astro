---
import { withBase } from '../../lib/paths';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SermonCard from '../../components/SermonCard.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import site from '../../content/site.json';
import worship from '../../content/worship.json';

const sermons = (await getCollection('sermons')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const description =
  'Listen and reflect on sermons from CDPC Puchong — Christ-centred, Scripture-based expository preaching in Bandar Puchong Jaya.';
---

<BaseLayout title="Sermons" description={description}>
  <PageHero
    eyebrow="Sermons"
    title="Teaching for the whole of life."
    intro={site.word}
    breadcrumbs={[{ label: 'Sermons' }]}
  >
    <div slot="aside" class="sermon-hero-note">
      <p class="eyebrow">Our preaching</p>
      <p class="mt-4 font-display text-[clamp(1.45rem,2.4vw,1.9rem)] leading-[1.22] tracking-[-0.025em]">
        Scripture read and preached, centring us on Christ, the Gospel and the Word.
      </p>
      <a class="text-link mt-6" href={withBase('/worship')}>
        About our worship
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="recent-sermons-title">
    <div class="container-page">
      <div class="section-top">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Recent teaching</p>
          <h2 class="h2" id="recent-sermons-title">Sermons to read and reflect on.</h2>
        </div>
        <p class="max-w-xs text-[0.8rem] leading-relaxed text-[var(--ink-faint)]" data-reveal>
          <span class="status-chip mb-3">Media being prepared</span>
          Audio, video and full sermon notes are being added. Message us if you would like
          to listen or read more in the meantime.
        </p>
      </div>

      {
        sermons.length > 0 ? (
          <div class="sermon-grid">
            {sermons.map((sermon, index) => (
              <div data-reveal style={`--delay: ${(index % 2) * 70}ms`}>
                <SermonCard sermon={sermon} index={index + 1} />
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-note">
            <p class="eyebrow">Sermons</p>
            <h3 class="mt-4 font-display text-[2rem] tracking-[-0.03em]">Coming soon.</h3>
            <p class="mt-3 max-w-md text-[0.95rem] leading-relaxed text-[var(--ink-soft)]">
              Sermons will be listed here once they are ready. In the meantime, message us
              and we will be glad to help.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section-sm bg-[var(--paper-2)]" aria-labelledby="preaching-title">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5" data-reveal>
          <p class="eyebrow">How we listen</p>
          <h2 class="h2 mt-5" id="preaching-title">Not just information. Formation.</h2>
        </div>
        <div class="lg:col-span-6 lg:col-start-7" data-reveal style="--delay: 100ms">
          <p class="lead">
            We believe Scripture is God's living Word to us. Preaching is not a lecture
            about religion, but an invitation to meet Christ and be reshaped by grace.
          </p>
          <div class="mt-7 grid gap-3 sm:grid-cols-3">
            {
              worship.pillars.map((pillar) => (
                <div class="border-t border-[var(--line-strong)] pt-4">
                  <p class="font-display text-[1.08rem] leading-snug tracking-[-0.02em]">
                    {pillar.title}
                  </p>
                </div>
              ))
            }
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn--primary" href={withBase('/beliefs')}>
              What we believe
              <Icon name="arrow-right" size={16} />
            </a>
            <a class="btn btn--ghost" href={withBase('/visit')}>
              Join us on Sunday
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="Sundays at 9:00AM"
    title="Hear the Word with us."
    text="Join us at IOI Boulevard, Puchong. Plan your first visit or send us a message — we would be glad to welcome you."
  />
</BaseLayout>
