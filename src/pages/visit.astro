---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SundayCard from '../components/SundayCard.astro';
import InfoCard from '../components/InfoCard.astro';
import MapArt from '../components/MapArt.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';
import visit from '../content/visit.json';
import leadership from '../content/leadership.json';

const description =
  'Planning your first visit to CDPC Puchong? Find the service time, address, parking, children, accessibility and a simple step-by-step of a Sunday — plus a WhatsApp contact.';

const mapQuery = encodeURIComponent(site.address.full);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
const wazeUrl = `https://www.waze.com/ul?q=${encodeURIComponent(
  `${site.address.unit}, ${site.address.street}, ${site.address.city}`,
)}&navigate=yes`;

const icons: Record<string, string> = {
  when: 'clock',
  where: 'map-pin',
  parking: 'navigation',
  wear: 'sun',
  length: 'clock',
  language: 'message-circle',
  children: 'library',
  accessibility: 'accessibility',
};

const links: Record<string, { href: string; label: string }> = {
  where: { href: '/where-we-gather', label: 'Directions' },
  children: { href: '/childrens-library', label: "Children's Library" },
  parking: { href: '/where-we-gather', label: 'Getting here' },
};
---

<BaseLayout title="Plan Your Visit" description={description}>
  <PageHero
    eyebrow="Plan your visit"
    title="Your first Sunday, made simple."
    intro={visit.intro}
    breadcrumbs={[{ label: 'Plan Your Visit' }]}
  >
    <SundayCard slot="aside" />
  </PageHero>

  <section class="section" aria-labelledby="flow-title">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4 lg:sticky lg:top-32 lg:self-start" data-reveal>
          <p class="eyebrow">What happens</p>
          <h2 class="h2 mt-5" id="flow-title">The shape of a Sunday.</h2>
          <p class="lead mt-6">
            We gather around Christ, open the Scriptures and make room to respond. The exact
            order is still being confirmed, but this is the general rhythm.
          </p>
          <p class="status-chip mt-6">Flow and timings being confirmed</p>
        </div>

        <div class="lg:col-span-8" data-reveal style="--delay: 80ms">
          <div class="flow-list">
            {
              visit.flow.steps.map((step) => (
                <div class="flow-step">
                  <span class="flow-step__number">{step.number}</span>
                  <h3 class="flow-step__title">{step.title}</h3>
                  <p class="flow-step__text">{step.text}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-6 flex items-start gap-3 text-[0.8rem] leading-relaxed text-[var(--ink-faint)]">
            <Icon name="info" size={16} class="mt-0.5 shrink-0 text-[var(--gold)]" />
            {visit.flow.note}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--paper-2)]" aria-labelledby="practical-title">
    <div class="container-page">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Practical details</p>
        <h2 class="h2" id="practical-title">Everything else you might wonder.</h2>
        <p class="lead">
          We would rather be honest than guess. Anything marked “being confirmed” is a real
          placeholder — message us and we will tell you what we know.
        </p>
      </div>

      <!-- TODO: confirm with church — parking, dress, service length, language, children's programme/check-in, and accessibility details are placeholders. -->
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          visit.cards.map((card, index) => (
            <div data-reveal style={`--delay: ${(index % 4) * 60}ms`}>
              <InfoCard
                icon={icons[card.id] ?? 'info'}
                title={card.title}
                text={card.text}
                status={card.status as 'confirmed' | 'to-confirm' | 'partly-confirmed'}
                href={links[card.id]?.href}
                linkLabel={links[card.id]?.label}
              />
            </div>
          ))
        }
      </div>

      <div class="mt-6 flex items-start gap-3" data-reveal>
        <Icon name="info" size={16} class="mt-0.5 shrink-0 text-[var(--gold)]" />
        <p class="text-[0.8rem] leading-relaxed text-[var(--ink-faint)]">
          Want the quickest answer? Message us on WhatsApp — a real person from the church
          will get back to you.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="people-title">
    <div class="container-page">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5" data-reveal>
          <p class="eyebrow">Who you'll meet</p>
          <h2 class="h2 mt-5" id="people-title">Ordinary people, following Jesus.</h2>
          <p class="lead mt-6">{visit.people.text}</p>
          <p class="mt-4 text-sm leading-relaxed text-[var(--ink-faint)]">{visit.people.note}</p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a class="btn btn--ghost" href="/leadership">
              Meet our leaders
              <Icon name="arrow-right" size={16} />
            </a>
            <a
              class="text-link"
              href={site.contact.whatsapp}
              target="_blank"
              rel="noopener"
            >
              <Icon name="message-circle" size={16} />
              Say hello first
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-7" data-reveal style="--delay: 100ms">
          <div class="pastor-card">
            <div class="pastor-card__monogram" aria-hidden="true">JN</div>
            <div>
              <p class="eyebrow">Pastor</p>
              <h3 class="mt-3 font-display text-[2rem] leading-none tracking-[-0.03em]">
                {leadership.pastor.name}
              </h3>
              <p class="mt-3 text-[0.92rem] leading-relaxed text-[var(--ink-soft)]">
                Pastor Josh Ng serves CDPC Puchong together with our elders and deacons. You
                can meet the whole leadership team before you arrive.
              </p>
              <a class="text-link mt-3" href="/leadership">
                Elders &amp; deacons
                <Icon name="arrow-right" size={15} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="arrival-title">
    <div class="container-page">
      <div class="section-head mb-10" data-reveal>
        <p class="eyebrow">Getting here</p>
        <h2 class="h2" id="arrival-title">Finding the room.</h2>
        <!-- TODO: confirm with church — add exact directions from the IOI Boulevard lift lobby, parking level, and any building access instructions. -->
        <p class="lead">{visit.arrival.text}</p>
        <span class="status-chip">Route details being confirmed</span>
      </div>

      <div class="map-card" data-reveal>
        <div class="map-card__art">
          <MapArt />
        </div>
        <div class="map-card__body">
          <div>
            <p class="eyebrow">The address</p>
            <address class="address mt-4">
              <strong>7th Floor, IOI Boulevard, Unit B, 01</strong><br />
              Jalan Kenari 5, Bandar Puchong Jaya<br />
              47170 Puchong, Selangor, Malaysia
            </address>
            <p class="mt-4 flex items-center gap-2 text-[0.85rem] text-[var(--ink-soft)]">
              <Icon name="clock" size={16} class="text-[var(--accent)]" />
              Sundays · Worship Service at 9:00AM
            </p>
          </div>
          <div>
            <div class="map-actions">
              <a class="btn btn--primary btn--small" href={googleMapsUrl} target="_blank" rel="noopener">
                <Icon name="map-pin" size={16} />
                Google Maps <span class="sr-only"> (opens in a new tab)</span></a>
              <a class="btn btn--ghost btn--small" href={wazeUrl} target="_blank" rel="noopener">
                <Icon name="navigation" size={16} />
                Waze <span class="sr-only"> (opens in a new tab)</span></a>
              <a
                class="btn btn--ghost btn--small"
                href={site.contact.whatsapp}
                target="_blank"
                rel="noopener"
              >
                <Icon name="message-circle" size={16} />
                Ask for help
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </div>
            <a class="text-link mt-4" href="/where-we-gather">
              More on where we gather
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--paper-2)]" aria-labelledby="faq-title">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4" data-reveal>
          <p class="eyebrow">Good questions</p>
          <h2 class="h2 mt-5" id="faq-title">Before you come.</h2>
          <p class="lead mt-6">
            Still wondering about something? These are the questions we hear most — and you
            can always ask us directly.
          </p>
          <a
            class="btn btn--primary mt-7"
            href={site.contact.whatsapp}
            target="_blank"
            rel="noopener"
          >
            <Icon name="message-circle" size={17} />
            Message us, we'd love to help
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>

        <div class="lg:col-span-8" data-reveal style="--delay: 80ms">
          <div class="faq-list">
            {
              visit.faqs.map((faq) => (
                <details class="faq-item" name="visit-faq">
                  <summary>
                    <span>{faq.question}</span>
                    <span class="faq-icon" aria-hidden="true" />
                  </summary>
                  <div class="faq-answer">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container-page">
      <div class="invite-panel" data-reveal>
        <div>
          <p class="eyebrow">One more thing</p>
          <h2 class="invite-panel__title mt-4">You are welcome here — really.</h2>
          <p class="mt-4 max-w-xl text-[0.95rem] leading-relaxed text-[var(--ink-soft)]">
            If you are nervous, curious, or simply want to know where the lift is, send us a
            message. We will be glad to help you take the next step.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn--primary" href={site.contact.whatsapp} target="_blank" rel="noopener">
            <Icon name="message-circle" size={17} />
            WhatsApp us <span class="sr-only"> (opens in a new tab)</span></a>
          <a class="btn btn--ghost" href="/beliefs">
            What we believe
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
